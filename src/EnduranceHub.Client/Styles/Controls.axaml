<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ ТЕКСТ ============ -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="19"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="0.8"/>
    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource NumFont}"/>
  </Style>
  <Style Selector="TextBlock.clock">
    <Setter Property="FontFamily" Value="{DynamicResource NumFont}"/>
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="TextBlock.big">
    <Setter Property="FontFamily" Value="{DynamicResource NumFont}"/>
    <Setter Property="FontSize" Value="34"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="TextBlock.pos">
    <Setter Property="FontFamily" Value="{DynamicResource NumFont}"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- время круга: фиолетовый — лучший в сессии, зелёный — личный лучший -->
  <Style Selector="TextBlock.time">
    <Setter Property="FontFamily" Value="{DynamicResource NumFont}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="TextBlock.time.pb"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/></Style>
  <Style Selector="TextBlock.time.best"><Setter Property="Foreground" Value="{DynamicResource BestBrush}"/></Style>
  <Style Selector="TextBlock.gap">
    <Setter Property="FontFamily" Value="{DynamicResource NumFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
  </Style>
  <Style Selector="TextBlock.ahead"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></Style>
  <Style Selector="TextBlock.behind"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/></Style>
  <Style Selector="TextBlock.good"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/></Style>
  <Style Selector="TextBlock.bad"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>

  <!-- ============ ИКОНКИ ============ -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Stretch" Value="None"/>
    <Setter Property="Stroke" Value="{DynamicResource Text2Brush}"/>
    <Setter Property="StrokeThickness" Value="1.8"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
  </Style>

  <!-- ============ КАРТОЧКИ ============ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.cardhead">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="16,12"/>
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14"/>
  </Style>

  <!-- ============ КНОПКИ ============ -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#FFFFFF"/>
    <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!-- ============ ПОЛЯ ВВОДА ============ -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="TextBox:focus /template/ Border">
    <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- ============ ПОЛОСЫ ПРОГРЕССА (педали, руль) ============ -->
  <Style Selector="ProgressBar.gauge">
    <Setter Property="Height" Value="8"/>
    <Setter Property="MinHeight" Value="8"/>
    <Setter Property="Maximum" Value="100"/>
    <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="ProgressBar.gas"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/></Style>
  <Style Selector="ProgressBar.brake"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
  <Style Selector="ProgressBar.steer"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/></Style>

  <!-- ============ ЧИПЫ И НОМЕРА ============ -->
  <Style Selector="Border.chip">
    <Setter Property="Padding" Value="9,2"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
  </Style>
  <Style Selector="Border.chip.ok"><Setter Property="Background" Value="{DynamicResource GoodSoftBrush}"/></Style>
  <Style Selector="Border.chip.ok > TextBlock"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/></Style>
  <Style Selector="Border.chip.warn"><Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/></Style>
  <Style Selector="Border.chip.warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></Style>
  <Style Selector="Border.chip.bad"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/></Style>
  <Style Selector="Border.chip.bad > TextBlock"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>

  <Style Selector="Border.numbadge">
    <Setter Property="MinWidth" Value="40"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.numbadge > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource NumFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Border.numbadge.own"><Setter Property="Background" Value="{DynamicResource OwnBrush}"/></Style>
  <Style Selector="Border.numbadge.own > TextBlock"><Setter Property="Foreground" Value="{DynamicResource OnOwnBrush}"/></Style>

  <!-- ============ НАВИГАЦИЯ СЛЕВА ============ -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource OwnBrush}"/>
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!-- ============ ЛОГИ SERVER/AGENT ============ -->
  <Style Selector="ListBox.log">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBox.log > ListBoxItem">
    <Setter Property="Padding" Value="2,0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
  </Style>
  <Style Selector="ListBox.log > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.log > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- ============ СЕГМЕНТ-ПЕРЕКЛЮЧАТЕЛЬ ============ -->
  <Style Selector="ListBox.seg">
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.seg > ListBoxItem">
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
  </Style>
  <Style Selector="ListBox.seg > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="ListBox.seg > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!-- ============ ТАБЛИЦЫ (ListBox со строками) ============ -->
  <Style Selector="ListBox.table">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBox.table > ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="ListBox.table > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
  </Style>
  <Style Selector="ListBox.table > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
  </Style>
  <Style Selector="Border.row">
    <Setter Property="Height" Value="58"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Border.row.own"><Setter Property="Background" Value="{DynamicResource OwnSoftBrush}"/></Style>
  <Style Selector="Border.row.compact"><Setter Property="Height" Value="46"/></Style>
  <Style Selector="Border.ownbar">
    <Setter Property="Width" Value="3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Background" Value="{DynamicResource OwnBrush}"/>
  </Style>
  <Style Selector="Border.thead">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="14,10"/>
  </Style>

  <!-- строки стинтов: открытый стинт подсвечен -->
  <Style Selector="TextBlock.open"><Setter Property="Foreground" Value="{DynamicResource OwnBrush}"/></Style>

  <!-- ============ ФЛАГИ ============ -->
  <Style Selector="Border.flagline">
    <Setter Property="Height" Value="3"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
  </Style>
  <Style Selector="Border.flagline.green"><Setter Property="Background" Value="{DynamicResource FlagGreenBrush}"/></Style>
  <Style Selector="Border.flagline.yellow"><Setter Property="Background" Value="{DynamicResource FlagYellowBrush}"/></Style>
  <Style Selector="Border.flagline.red"><Setter Property="Background" Value="{DynamicResource FlagRedBrush}"/></Style>
  <Style Selector="Border.flagline.white"><Setter Property="Background" Value="{DynamicResource FlagWhiteBrush}"/></Style>
  <Style Selector="Border.flagline.chequered"><Setter Property="Background" Value="{DynamicResource FlagWhiteBrush}"/></Style>

  <Style Selector="Border.flagchip">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="11,0,14,0"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.flagchip.green">
    <Setter Property="BorderBrush" Value="{DynamicResource FlagGreenBrush}"/>
    <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}"/>
  </Style>
  <Style Selector="Border.flagchip.yellow">
    <Setter Property="BorderBrush" Value="{DynamicResource FlagYellowBrush}"/>
    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
  </Style>
  <Style Selector="Border.flagchip.red">
    <Setter Property="BorderBrush" Value="{DynamicResource FlagRedBrush}"/>
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
  </Style>
  <Style Selector="Border.flagchip.white">
    <Setter Property="BorderBrush" Value="{DynamicResource FlagWhiteBrush}"/>
  </Style>
  <Style Selector="Border.flagchip.chequered">
    <Setter Property="BorderBrush" Value="{DynamicResource FlagWhiteBrush}"/>
  </Style>

  <Style Selector="Ellipse.flagdot">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Height" Value="10"/>
    <Setter Property="Fill" Value="{DynamicResource Text3Brush}"/>
  </Style>
  <Style Selector="Ellipse.flagdot.green"><Setter Property="Fill" Value="{DynamicResource FlagGreenBrush}"/></Style>
  <Style Selector="Ellipse.flagdot.yellow"><Setter Property="Fill" Value="{DynamicResource FlagYellowBrush}"/></Style>
  <Style Selector="Ellipse.flagdot.red"><Setter Property="Fill" Value="{DynamicResource FlagRedBrush}"/></Style>
  <Style Selector="Ellipse.flagdot.white"><Setter Property="Fill" Value="{DynamicResource FlagWhiteBrush}"/></Style>
  <Style Selector="Ellipse.flagdot.chequered"><Setter Property="Fill" Value="{DynamicResource FlagWhiteBrush}"/></Style>

  <!-- широкая полоса под шапкой при жёлтом / красном / белом / клетчатом флаге -->
  <Style Selector="Border.flagbanner">
    <Setter Property="Padding" Value="20,9"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
  </Style>
  <Style Selector="Border.flagbanner.yellow"><Setter Property="Background" Value="{DynamicResource FlagYellowBrush}"/></Style>
  <Style Selector="Border.flagbanner.red"><Setter Property="Background" Value="{DynamicResource FlagRedBrush}"/></Style>
  <Style Selector="Border.flagbanner.white"><Setter Property="Background" Value="{DynamicResource FlagWhiteBrush}"/></Style>
  <Style Selector="Border.flagbanner.chequered"><Setter Property="Background" Value="{DynamicResource FlagWhiteBrush}"/></Style>
  <Style Selector="Border.flagbanner.yellow TextBlock">
    <Setter Property="Foreground" Value="#10141B"/>
  </Style>
  <Style Selector="Border.flagbanner.red TextBlock">
    <Setter Property="Foreground" Value="#10141B"/>
  </Style>
  <Style Selector="Border.flagbanner.white TextBlock">
    <Setter Property="Foreground" Value="#10141B"/>
  </Style>
  <Style Selector="Border.flagbanner.chequered TextBlock">
    <Setter Property="Foreground" Value="#10141B"/>
  </Style>

  <!-- плашки секторов S1–S3 в жёлтой полосе -->
  <Style Selector="Border.sector">
    <Setter Property="Padding" Value="9,2"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="#33000000"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.sector.on"><Setter Property="Background" Value="#10141B"/></Style>
  <Style Selector="Border.flagbanner Border.sector.on TextBlock"><Setter Property="Foreground" Value="#FFC247"/></Style>

  <!-- ============ РАДАР: список «Рядом» ============ -->
  <Style Selector="Border.near">
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="Border.near.warn"><Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/></Style>
  <Style Selector="Border.near.danger"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/></Style>
  <Style Selector="Border.spotter">
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="Background" Value="{DynamicResource GoodSoftBrush}"/>
  </Style>
  <Style Selector="Border.spotter.danger"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/></Style>
  <Style Selector="Ellipse.spotdot">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="Fill" Value="{DynamicResource GoodBrush}"/>
  </Style>
  <Style Selector="Ellipse.spotdot.danger"><Setter Property="Fill" Value="{DynamicResource DangerBrush}"/></Style>
  <Style Selector="TextBlock.spottext.danger"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
</Styles>
