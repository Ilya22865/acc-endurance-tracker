<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AccEndurance.Client.ViewModels"
        xmlns:conv="using:AccEndurance.Client.Converters"
        x:Class="AccEndurance.Client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ACC Endurance — сервис команды"
        Width="1280" Height="760" MinWidth="980" MinHeight="620"
        RequestedThemeVariant="Dark"
        Background="#14171C"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#E1E6F0"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8A93A5"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#2EBD93"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#26A57F"/>
    </Style>
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="#262B35"/>
      <Setter Property="Foreground" Value="#C9D2DF"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#303745"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#222833"/>
      <Setter Property="Foreground" Value="#E1E6F0"/>
      <Setter Property="BorderBrush" Value="#333B4A"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#222833"/>
      <Setter Property="Foreground" Value="#E1E6F0"/>
      <Setter Property="BorderBrush" Value="#333B4A"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#262B35"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*" Margin="14">

    <!-- Header -->
    <Border Background="#1B2027" CornerRadius="10" Padding="18,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="20">
          <TextBlock Text="{Binding SessionText}" Classes="h1"/>
          <TextBlock Text="{Binding PhaseText}" Classes="muted"/>
          <TextBlock Text="{Binding TimeText}" Foreground="#FFC94A" FontWeight="SemiBold" FontSize="13"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <TextBlock Text="{Binding OurDriverText}" FontSize="14" FontWeight="SemiBold" Foreground="#2EBD93"/>
          <TextBlock Text="{Binding ConnectionStatus}" Classes="muted"/>
          <Button Content="Подключить" Command="{Binding ConnectCommand}" Classes="accent"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main: sidebar + pages -->
    <Grid Grid.Row="1" ColumnDefinitions="208,*" Margin="0,12,0,0">

      <!-- Sidebar -->
      <Border Background="#1B2027" CornerRadius="10" Padding="10,16">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="РАЗДЕЛЫ" FontSize="11" FontWeight="Bold" Foreground="#5A6472"
                     Margin="14,0,0,10" Opacity="0.6"/>
          <ListBox ItemsSource="{Binding NavItems}"
                   SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                   Background="Transparent">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="2,2"/>
                <Setter Property="Padding" Value="10,4"/>
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="#2A2F3A"/>
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#222833"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Grid ColumnDefinitions="32,12,Auto" Height="34">
                  <Border Width="28" Height="28" CornerRadius="7" Background="{Binding Accent}">
                    <TextBlock Text="{Binding Code}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                             Foreground="#D7DEE8" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Pages -->
      <Border Grid.Column="1" Background="#1B2027" CornerRadius="10" ClipToBounds="True">
        <Panel>

        <!-- PAGE 0 — ПОЗИЦИИ -->
        <Panel IsVisible="{Binding IsPage0}" Margin="12">
          <Border Background="#1F242E" BorderBrush="#2C333F" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
              <Border Background="#262B35" BorderBrush="#2C333F" BorderThickness="0,0,0,1">
                <Grid Margin="4,0" ColumnDefinitions="48,56,195,110,165,60,70,96,96">
                  <TextBlock Text="P"  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                  <TextBlock Grid.Column="1" Text="№"  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                  <TextBlock Grid.Column="2" Text="Команда" FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                  <TextBlock Grid.Column="3" Text="Пилот"  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                  <TextBlock Grid.Column="4" Text="Машина" FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                  <TextBlock Grid.Column="5" Text="Круги"  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                  <TextBlock Grid.Column="6" Text="Гэп"    FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                  <TextBlock Grid.Column="7" Text="Посл."  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                  <TextBlock Grid.Column="8" Text="Лучш."  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Standings}" Margin="0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StandingsRow">
                      <Border Background="{Binding RowBackground}" BorderBrush="{Binding RowBorderBrush}"
                              BorderThickness="{Binding RowBorder}">
                        <Grid ColumnDefinitions="48,56,195,110,165,60,70,96,96" Margin="4,0">
                          <TextBlock Text="{Binding Position}" Padding="6,8" Foreground="#E1E6F0"/>
                          <TextBlock Grid.Column="1" Text="{Binding RaceNumber}" Padding="6,8" FontWeight="SemiBold" Foreground="#E1E6F0"/>
                          <TextBlock Grid.Column="2" Text="{Binding TeamName}" Padding="6,8" Foreground="#C9D2DF"/>
                          <TextBlock Grid.Column="3" Text="{Binding Driver}" Padding="6,8" FontWeight="SemiBold" Foreground="{Binding DriverBrush}"/>
                          <TextBlock Grid.Column="4" Text="{Binding CarModel}" Padding="6,8" Foreground="#C9D2DF"/>
                          <TextBlock Grid.Column="5" Text="{Binding Laps}" Padding="6,8" Foreground="#E1E6F0"/>
                          <TextBlock Grid.Column="6" Text="{Binding Gap}" Padding="6,8" Foreground="#E1E6F0"/>
                          <TextBlock Grid.Column="7" Text="{Binding LastLap}" Padding="6,8" Foreground="#C9D2DF"/>
                          <TextBlock Grid.Column="8" Text="{Binding BestLap}" Padding="6,8" Foreground="#FFC94A" FontWeight="SemiBold"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Panel>

        <!-- PAGE 1 — СТИНТЫ -->
        <Panel IsVisible="{Binding IsPage1}" Margin="12">
          <Grid RowDefinitions="Auto,*">
            <!-- Edit bar -->
            <Border Background="#1F242E" BorderBrush="#2C333F" BorderThickness="1" CornerRadius="8,8,0,0" Padding="12,10" ClipToBounds="True">
              <Grid ColumnDefinitions="Auto,*,Auto,80,Auto,60,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="Заметки" Foreground="#C9D2DF" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" PlaceholderText="заметки по стинту" Text="{Binding EditNotes}"/>
                <TextBlock Grid.Column="2" Text="Топливо, л" Foreground="#C9D2DF" VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" Width="80" Text="{Binding EditFuel}"/>
                <TextBlock Grid.Column="4" Text="Круги" Foreground="#C9D2DF" VerticalAlignment="Center"/>
                <TextBox Grid.Column="5" Width="60" Text="{Binding EditLaps}"/>
                <Button Grid.Column="7" Content="Сохранить" Command="{Binding SaveStintCommand}" Classes="accent" Margin="8,0,0,0"/>
              </Grid>
            </Border>
            <!-- List -->
            <Border Grid.Row="1" Background="#1F242E" BorderBrush="#2C333F" BorderThickness="1,0,1,1"
                    CornerRadius="0,0,8,8" ClipToBounds="True">
              <Grid RowDefinitions="Auto,*">
                <Border Background="#262B35" BorderBrush="#2C333F" BorderThickness="0,0,0,1" ClipToBounds="True">
                  <Grid Margin="4,0" ColumnDefinitions="110,42,88,88,88,88,76,52">
                    <TextBlock Text="Пилот"  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                    <TextBlock Grid.Column="1" Text="№"   FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                    <TextBlock Grid.Column="2" Text="Старт реал"  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                    <TextBlock Grid.Column="3" Text="Старт игра"  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                    <TextBlock Grid.Column="4" Text="Финиш реал"  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                    <TextBlock Grid.Column="5" Text="Финиш игра"  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                    <TextBlock Grid.Column="6" Text="Длит."  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                    <TextBlock Grid.Column="7" Text="Круг"  FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                  </Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding Stints}" SelectedItem="{Binding SelectedStint}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:StintRow">
                      <Border BorderBrush="#2C333F" BorderThickness="0,0,0,1" Padding="0,1">
                        <Grid ColumnDefinitions="110,42,88,88,88,88,76,52" Margin="4,0">
                          <TextBlock Grid.Column="0" Text="{Binding Driver}" Padding="6,7" FontWeight="SemiBold"
                                     Foreground="{Binding IsOpen, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter=#2EBD93;#E1E6F0}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Ordinal}" Padding="6,7" Foreground="#8A93A5"/>
                          <TextBlock Grid.Column="2" Text="{Binding StartReal}" Padding="6,7" Foreground="#C9D2DF"/>
                          <TextBlock Grid.Column="3" Text="{Binding StartGame}" Padding="6,7" Foreground="#C9D2DF"/>
                          <TextBlock Grid.Column="4" Text="{Binding EndReal}" Padding="6,7" Foreground="#C9D2DF"/>
                          <TextBlock Grid.Column="5" Text="{Binding EndGame}" Padding="6,7" Foreground="#C9D2DF"/>
                          <TextBlock Grid.Column="6" Text="{Binding Duration}" Padding="6,7" Foreground="#FFC94A" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="7" Text="{Binding LapNumber}" Padding="6,7" Foreground="#C9D2DF"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </Panel>

        <!-- PAGE 2 — СЕТАП -->
        <Panel IsVisible="{Binding IsPage2}" Margin="12">
          <Grid RowDefinitions="Auto,Auto,*">
            <!-- Toolbar -->
            <Border Background="#1F242E" BorderBrush="#2C333F" BorderThickness="1" CornerRadius="8,8,0,0" Padding="12,10" ClipToBounds="True">
              <Grid ColumnDefinitions="Auto,200,Auto,220,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="Авто" Foreground="#C9D2DF" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SetupCars}" SelectedItem="{Binding SelectedSetupCar}"/>
                <TextBlock Grid.Column="2" Text="Трасса" Foreground="#C9D2DF" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding SetupTracks}" SelectedItem="{Binding SelectedSetupTrack}"/>
                <Button Grid.Column="5" Content="Обновить" Command="{Binding RefreshSetupsCommand}" Classes="subtle"/>
                <Button Grid.Column="6" Content="Папка" Command="{Binding OpenSetupFolderCommand}" Classes="subtle" Margin="8,0,0,0"/>
              </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="{Binding SetupStatus}" Classes="muted" Margin="4,6,4,4"/>
            <!-- Content -->
            <Grid Grid.Row="2" ColumnDefinitions="320,10,*">
              <Border Background="#1F242E" BorderBrush="#2C333F" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                  <Border Background="#262B35" BorderBrush="#2C333F" BorderThickness="0,0,0,1">
                    <Grid Margin="8,0" ColumnDefinitions="*,100,72">
                      <TextBlock Text="Файл" FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                      <TextBlock Grid.Column="1" Text="Изменён" FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                      <TextBlock Grid.Column="2" Text="Размер" FontWeight="Bold" Foreground="#C9D2DF" Padding="6,10"/>
                    </Grid>
                  </Border>
                  <ListBox Grid.Row="1" ItemsSource="{Binding SetupFiles}" SelectedItem="{Binding SelectedSetupFile}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SetupFileRow">
                        <Border Padding="8,6" BorderBrush="#2C333F" BorderThickness="0,0,0,1">
                          <Grid ColumnDefinitions="*,100,72">
                            <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="#E1E6F0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" FontSize="12" Foreground="#8A93A5"/>
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" Foreground="#8A93A5"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Border Grid.Column="2" Background="#1F242E" BorderBrush="#2C333F" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <DockPanel>
                  <!-- Raw JSON bottom -->
                  <Border DockPanel.Dock="Bottom" Background="#151A22" BorderBrush="#2C333F" BorderThickness="0,1,0,0"
                          Padding="6,4">
                    <Expander Header="RAW JSON">
                      <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SetupJson}" FontFamily="Cascadia Code, Consolas, monospace"
                                   FontSize="11" Foreground="#8A93A5" TextWrapping="Wrap" Margin="10,6"/>
                      </ScrollViewer>
                    </Expander>
                  </Border>
                  <!-- Section cards -->
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SetupSections}" Margin="14">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SetupSection">
                          <Border Width="330" Margin="0,0,10,10" CornerRadius="10"
                                  Background="#1A1F29" BorderBrush="#2C333F" BorderThickness="1"
                                  ClipToBounds="True">
                            <StackPanel>
                              <Border Background="{Binding Accent}" Padding="14,10">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                              </Border>
                              <ItemsControl ItemsSource="{Binding Items}" Margin="14,12,14,14">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:SetupValue">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                      <TextBlock Text="{Binding Key}" FontSize="12" Foreground="#8A93A5"
                                                 TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                                                 Foreground="#E1E6F0"/>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>
          </Grid>
        </Panel>

        <!-- PAGE 3 — КАРТА -->
        <Panel IsVisible="{Binding IsPage3}" Margin="12">
          <Grid ColumnDefinitions="*,260">
            <Border Background="#161B23" BorderBrush="#2C333F" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
              <Grid RowDefinitions="Auto,*">
                <Border Background="#262B35" BorderBrush="#2C333F" BorderThickness="0,0,0,1" Padding="14,10">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Карта трассы" Classes="h1"/>
                    <TextBlock Text="{Binding MapTrackName}" Classes="muted"/>
                  </StackPanel>
                </Border>
                <Canvas Grid.Row="1" x:Name="MapCanvas" Background="#12161D"/>
              </Grid>
            </Border>
            <Border Grid.Column="1" Background="#1F242E" BorderBrush="#2C333F" BorderThickness="1" CornerRadius="8"
                    Margin="10,0,0,0" Padding="18">
              <StackPanel Spacing="12">
                <TextBlock Text="ПОГОДА" FontSize="12" FontWeight="Bold" Foreground="#5A6472"/>
                <Grid ColumnDefinitions="110,*" ColumnSpacing="8">
                  <TextBlock Text="Воздух"  FontSize="13" Foreground="#8A93A5"/>
                  <TextBlock Grid.Column="1" Text="{Binding WeatherAir}" FontSize="13" FontWeight="SemiBold" Foreground="#E1E6F0"/>
                  <TextBlock Grid.Row="1" Text="Трек"    FontSize="13" Foreground="#8A93A5" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WeatherTrack}" FontSize="13" FontWeight="SemiBold" Foreground="#E1E6F0" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="2" Text="Дождь"   FontSize="13" Foreground="#8A93A5" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WeatherRain}" FontSize="13" FontWeight="SemiBold" Foreground="#E1E6F0" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="3" Text="Облачн." FontSize="13" Foreground="#8A93A5" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WeatherClouds}" FontSize="13" FontWeight="SemiBold" Foreground="#E1E6F0" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="4" Text="Накопл. влага" FontSize="13" Foreground="#8A93A5" Margin="0,8,0,0"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WeatherWetness}" FontSize="13" FontWeight="SemiBold" Foreground="#E1E6F0" Margin="0,8,0,0"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Panel>

        </Panel>
      </Border>
    </Grid>
  </Grid>
</Window>